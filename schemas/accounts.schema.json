{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publisher account bindings (never include credentials)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platforms"
  ],
  "properties": {
    "platforms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "accounts"
        ],
        "additionalProperties": false,
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "name",
                "id"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "profile": {
                  "type": "string"
                },
                "ego": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "profileId",
                    "taskSpaceId",
                    "taskSpaceName",
                    "pageLabel",
                    "targetId"
                  ],
                  "properties": {
                    "profileId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "taskSpaceId": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "taskSpaceName": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pageLabel": {
                      "type": "string",
                      "pattern": "^p[1-9][0-9]*$"
                    },
                    "targetId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "apiUid": {
                      "type": "string"
                    }
                  }
                },
                "wechatApi": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "alias",
                    "slot"
                  ],
                  "properties": {
                    "alias": {
                      "type": "string",
                      "minLength": 1
                    },
                    "slot": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              },
              "anyOf": [
                {
                  "required": [
                    "ego"
                  ],
                  "properties": {
                    "ego": {}
                  }
                },
                {
                  "required": [
                    "wechatApi"
                  ],
                  "properties": {
                    "wechatApi": {}
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
